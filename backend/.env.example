DATABASE_URL=postgresql://user:pass@localhost:5432/weddingdb
REDIS_URL=redis://:replace-with-REDIS_PASSWORD@localhost:6379
# Generate with: openssl rand -hex 32 — example placeholder values are rejected at boot.
JWT_SECRET=
# Required by docker compose. Generate each with openssl rand -hex 32.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
PORT=8080
PUBLIC_URL=http://localhost:8080
# CORS_ORIGIN=https://yourdomain.com  # optional; unset reflects request origin without credentials
# TRUSTED_PROXIES=127.0.0.1  # set ONLY when behind a reverse proxy; enables X-Forwarded-For
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-one-time-password
